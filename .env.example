# .env.example

# --- App security (required) ---
APP_PASSWORD=
SESSION_SECRET=            # random 32+ character string
CRON_SECRET=               # random string; cron endpoint requires it

# --- Database (required) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY= # server only; never expose

# --- AI (Gemini required; OpenRouter optional fallback) ---
GEMINI_API_KEY=
GEMINI_MODEL=              # e.g. gemini-1.5-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=          # e.g. meta-llama/llama-3.1-8b-instruct:free

# --- News (all optional; RSS needs no key) ---
GNEWS_API_KEY=
NEWSDATA_API_KEY=

# --- Memes, GIFs, images (all optional) ---
IMGFLIP_USERNAME=
IMGFLIP_PASSWORD=
GIPHY_API_KEY=
PEXELS_API_KEY=
UNSPLASH_APP_ID=
UNSPLASH_ACCESS_KEY=
UNSPLASH_SECRET_KEY=

# --- Video (optional) ---
YOUTUBE_API_KEY=

# --- Alerts (Phase 2, optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Config ---
APP_URL=http://localhost:3000


# Note: CRON_SECRET, GNEWS_API_KEY, NEWSDATA_API_KEY above also power Live Wire.
